{
  "name": "ai-seo-content-engine",
  "version": "1.0.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder",
	"dist:win": "npm run build:frontend && electron-builder --win",
	"dist:lin": "npm run build:frontend && electron-builder --linux",
	"dist:mac": "npm run build:frontend && electron-builder --mac"
  },
  "build": {
    "appId": "com.seocontentengine.app",
    "productName": "AI SEO Content Engine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0"
  }
}
